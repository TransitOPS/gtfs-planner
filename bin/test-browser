#!/usr/bin/env bash
#
# Run the Playwright browser suite against a throwaway Postgres.
#
# Each run gets its own Postgres server (ephemeralpg's `pg_tmp`, installed with
# `brew install ephemeralpg`) and its own Phoenix port. The steps that touch the
# database are additive: create, migrate, seed. Nothing here drops a database;
# `pg_tmp` deletes the server's data directory after it has been idle.
#
# Usage: bin/test-browser [--keep] [playwright args...]
#
#   bin/test-browser                              whole suite
#   bin/test-browser e2e/ia_navigation.spec.js    one spec
#   bin/test-browser --grep "sign in"             tests by title
#   bin/test-browser --keep e2e/blocks.spec.js    print the URL and leave the
#                                                 database up for 4 hours idle
#
# The database reaches the app through GTFS_PLANNER_TEST_DATABASE_URL, which only
# this script and the CI job set. config/test.exs accepts it only for a loopback
# host and a database named `test` or `gtfs_planner_exunit*`, and ignores DATABASE_URL.
# On CI, a GTFS_PLANNER_TEST_DATABASE_URL that is already set is used as is: the job's
# service container is the disposable server.
set -euo pipefail

cd "$(dirname "$0")/.."

keep=
if [ "${1:-}" = "--keep" ]; then
  keep=1
  shift
fi

# shellcheck source=lib/browser-stack.sh
source bin/lib/browser-stack.sh

# shellcheck disable=SC2119 # zero-or-one conditional argument is intentional
start_database ${keep:+--keep}

# The load-error journey may disconnect only a reader on this disposable
# cluster. CI declares its container-owned data directory in the workflow;
# pg_tmp's directory belongs to this local run and is verified by the test.
if [ -z "${CI:-}" ]; then
  export FARE_EDITOR_OWNED_PG_DIR
  FARE_EDITOR_OWNED_PG_DIR=$(psql -X --no-psqlrc --tuples-only --no-align \
    --dbname "$GTFS_PLANNER_TEST_DATABASE_URL" -c 'SHOW data_directory')
fi

port=$(free_port)
echo "Phoenix: http://127.0.0.1:${port}" >&2

export MIX_ENV=test
# The Playwright server boots without test/test_helper.exs, which normally
# creates the task artifact root at ExUnit boot; ArtifactStorage never creates
# it itself, so create the configured root here for fresh machines.
mix run --no-start -e 'File.mkdir_p!(Application.fetch_env!(:gtfs_planner, :gtfs_task_artifacts_path))'
build_assets

# create, migrate, then seed with `mix run test/support/browser_seed.exs`.
prepare_database test/support/browser_seed.exs

export PLAYWRIGHT_PORT="$port"
unset PLAYWRIGHT_BASE_URL
npm --prefix assets run test:browser -- "$@"
