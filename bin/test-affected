#!/usr/bin/env bash
#
# Advisory diff-to-tests selector: print the focused tests for what changed since a base revision.
# It never replaces `mix precommit`, which stays the completion gate.
#
# Usage: bin/test-affected [--base <ref>] [--run]
#
#   --base <ref>   compare against <ref> (default: git merge-base HEAD origin/main)
#   --run          run the printed ExUnit command, then the printed JavaScript command, and exit
#                  with the first non-zero status; never runs browser tests, and runs nothing
#                  for the bin/test-all recommendation
#
# Changes are `git diff --name-status <base>` (committed and working-tree edits) plus untracked files.
# ExUnit files are selected from test/**/*_test.exs:
#   1. a changed or added test file is selected; a deleted one is skipped;
#   2. the `defmodule` names in each changed lib/**/*.ex are the changed modules (for a deleted
#      or renamed file, the base revision's content counts);
#   3. a test names module A.B.C when it contains the full name (not followed by `.[A-Z]` or an
#      identifier character), `alias A.B.{..C..}` (multi-line allowed), or `alias A.B` plus `B.C`;
#   4. one hop: lib files that name a changed module contribute their modules, and tests naming
#      those are selected too;
#   5. a selection over a quarter of the tracked test files, or a change under test/support/,
#      config/, mix.exs, mix.lock or priv/repo/migrations/, prints the bin/test-all
#      recommendation with the count instead of a file list.
# Dynamic references (apply/3, module names built from strings) are not seen.
#
# Other outputs, with paths relative to assets/ to match the commands in AGENTS.md:
#   - JavaScript: a changed assets/js/__tests__ file is selected, and so is every __tests__ file
#     with a relative import specifier (`from "../x"`, `import "../x"`, `import("../x")`) that
#     resolves to a changed assets/js module, with or without `.js`. A deleted or renamed module
#     counts by its base path, so the tests that still import it are selected. Files read through
#     fs and imports from assets/vendor or assets/qa are not seen. Command:
#     npm --prefix assets test -- <files>
#   - Browser: changed assets/e2e/*.spec.js files are listed with `bin/test-browser <files>`;
#     they are never executed here.
#   - Advisories: a change to lib/**/*.heex, a *_live.ex or *component(s).ex module, or a module
#     under lib/gtfs_planner_web/components/ prints that browser journeys may be affected.
set -euo pipefail

cd "$(dirname "$0")/.."

advisory="Advisory selection; mix precommit remains the completion gate."

usage() {
  echo "Usage: bin/test-affected [--base <ref>] [--run]" >&2
}

die() {
  echo "bin/test-affected: $*" >&2
  exit 2
}

base=
run=0
while [ $# -gt 0 ]; do
  case $1 in
    --run)
      run=1
      shift
      ;;
    --base)
      [ $# -ge 2 ] || { usage; exit 2; }
      base=$2
      shift 2
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

command -v rg >/dev/null || die "ripgrep (rg) is required"

if [ -z "$base" ]; then
  base=$(git merge-base HEAD origin/main 2>/dev/null) || die "cannot find a merge base with origin/main; pass --base <ref>"
else
  base=$(git rev-parse --verify --quiet "$base^{commit}") || die "unknown base revision: $base"
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/test-affected.XXXXXX")
trap 'rm -rf "$work"' EXIT

# Output sections already printed; a section start adds a blank line between sections.
printed=0
# Set by the reports below: 1 when the bin/test-all recommendation replaced the ExUnit list, and
# 1 when a `mix test` command was printed (the ones `--run` can execute).
exunit_full=0
exunit_run=0

section() {
  [ "$printed" -eq 0 ] || echo
  printed=$((printed + 1))
  echo "$1"
}

# Writes $work/changes.tsv: one `<status>\t<path>\t<base path>` line per changed file. The status
# is A, D, R or another git letter (treated as a modification); <base path> is the path at the base
# revision and differs from <path> only for renames.
collect_changes() {
  {
    git diff --name-status -z -M "$base" |
      while IFS= read -r -d '' status; do
        case $status in
          R*)
            IFS= read -r -d '' old
            IFS= read -r -d '' path
            ;;
          *)
            IFS= read -r -d '' path
            old=$path
            ;;
        esac
        printf '%s\t%s\t%s\n' "${status:0:1}" "$path" "$old"
      done
    git ls-files --others --exclude-standard -z |
      while IFS= read -r -d '' path; do
        printf 'A\t%s\t%s\n' "$path" "$path"
      done
  } >"$work/changes.tsv"
}

# `defmodule` names in the files given as arguments or, with none, on stdin. A nested module is
# qualified with the enclosing top-level module (one level of nesting).
# shellcheck disable=SC2016 # an awk program: nothing in it should expand
module_names_awk='
  FNR == 1 { top = "" }
  /^[ \t]*defmodule[ \t]+[A-Z]/ {
    line = $0
    sub(/^[ \t]*defmodule[ \t]+/, "", line)
    match(line, /^[A-Z][A-Za-z0-9_.]*/)
    name = substr(line, 1, RLENGTH)
    if ($0 ~ /^defmodule/) {
      top = name
      print name
    } else if (top != "") {
      print top "." name
    }
  }
'

# Modules defined in the newline-separated file names listed in the file $1.
modules_in_files() {
  [ -s "$1" ] || return 0
  tr '\n' '\0' <"$1" | xargs -0 awk "$module_names_awk"
}

# Writes $work/changed_modules.txt from the lib files in changes.tsv: base-revision content for
# every file that existed at the base, current content for every file that still exists.
collect_changed_modules() {
  awk -F'\t' '$1 != "A" && $3 ~ /^lib\/.*\.ex$/ { print $3 }' "$work/changes.tsv" |
    while IFS= read -r path; do
      git show "$base:$path" | awk "$module_names_awk"
    done >"$work/modules.base"
  awk -F'\t' '$1 != "D" && $2 ~ /^lib\/.*\.ex$/ { print $2 }' "$work/changes.tsv" >"$work/lib.current"
  { cat "$work/modules.base"; modules_in_files "$work/lib.current"; } |
    LC_ALL=C sort -u >"$work/changed_modules.txt"
}

# Reads module names on stdin and prints one rg pattern file line per way a file can name them (see
# rule 3). Dots are written [.] and boundaries consume a character because the regex engine used
# by rg -f has no lookaround. For module A.B.C, split k = 1..n-1 gives the parent A.B and rest C
# (the rule's forms), and shorter parents such as `alias A` with `A.B.C` are handled the same way.
module_patterns() {
  awk '
    function dots(s) { gsub(/[.]/, "[.]", s); return s }
    BEGIN {
      w = "A-Za-z0-9_"
      before = "(?m)(?:^|[^" w ".])"
      after = "(?:$|[^" w ".]|[.](?:[^A-Z]|$))"
      alias = "(?m)^[[:blank:]]*alias[[:blank:]]+"
    }
    {
      n = split($0, seg, ".")
      print before dots($0) after
      for (k = 1; k < n; k++) {
        parent = seg[1]
        for (i = 2; i <= k; i++) parent = parent "." seg[i]
        rest = seg[k + 1]
        for (i = k + 2; i <= n; i++) rest = rest "." seg[i]
        print alias dots(parent) "[.][{](?:[^}]*[,[:space:]])?" dots(rest) "[,}[:space:]]"
        print alias dots(parent) "[[:blank:]]*(?:$|,|#)(?s:.*)" before seg[k] "[.]" dots(rest) after
      }
    }
  '
}

# Files under directory $1 matching glob $2 that name a module listed in the file $3.
files_naming() {
  [ -s "$3" ] || return 0
  module_patterns <"$3" >"$work/patterns.txt"
  local status=0
  rg --no-config --files-with-matches --multiline --glob "$2" -f "$work/patterns.txt" -- "$1" || status=$?
  [ "$status" -le 1 ] || die "rg failed with exit status $status"
}

# Writes $work/exunit.txt (selected test files, sorted) and $work/foundation.txt (changed paths that
# call for the full run).
select_exunit() {
  awk -F'\t' '$1 != "D" && $2 ~ /^test\/.*_test\.exs$/ { print $2 }' "$work/changes.tsv" >"$work/tests.changed"

  collect_changed_modules
  files_naming lib '*.ex' "$work/changed_modules.txt" >"$work/lib.hop"
  { cat "$work/changed_modules.txt"; modules_in_files "$work/lib.hop"; } |
    LC_ALL=C sort -u >"$work/hop_modules.txt"
  { cat "$work/tests.changed"; files_naming test '*_test.exs' "$work/hop_modules.txt"; } |
    LC_ALL=C sort -u >"$work/exunit.txt"

  awk -F'\t' '
    {
      for (i = 2; i <= 3; i++) {
        if ($i ~ /^(test\/support\/|config\/|priv\/repo\/migrations\/)/ || $i == "mix.exs" || $i == "mix.lock") {
          print $i
          next
        }
      }
    }
  ' "$work/changes.tsv" | LC_ALL=C sort -u >"$work/foundation.txt"
}

report_exunit() {
  local count total
  count=$(awk 'END { print NR }' "$work/exunit.txt")
  total=$(git ls-files 'test/**/*_test.exs' | awk 'END { print NR }')

  if [ -s "$work/foundation.txt" ]; then
    exunit_full=1
    section ExUnit
    echo "  Run the full suite: bin/test-all"
    awk 'NR <= 3 { printf "%s%s", (NR > 1 ? ", " : "  Foundation change: "), $0 }
         END { if (NR > 3) printf " and %d more", NR - 3; print "" }' "$work/foundation.txt"
    echo "  Selected: $count of $total test files"
  elif [ $((count * 4)) -gt "$total" ]; then
    exunit_full=1
    section ExUnit
    echo "  Run the full suite: bin/test-all"
    echo "  Selected: $count of $total test files, more than a quarter of the suite"
  elif [ "$count" -gt 0 ]; then
    exunit_run=1
    section ExUnit
    sed 's/^/  /' "$work/exunit.txt"
    echo
    echo "  mix test $(paste -s -d ' ' "$work/exunit.txt")"
  fi
}

# Writes $work/js.txt (vitest files) and $work/e2e.txt (Playwright specs), sorted and relative to
# assets/ because both commands run through `--prefix assets` or its wrapper.
select_assets() {
  awk -F'\t' '$1 != "D" && $2 ~ /^assets\/js\/__tests__\/.+\.js$/ { print $2 }' "$work/changes.tsv" >"$work/js.changed"

  # Changed modules: the current path and, for a file that existed at the base, the base path.
  awk -F'\t' '
    function add(p) { if (p ~ /^assets\/js\// && p !~ /^assets\/js\/__tests__\//) print p }
    $1 != "A" { add($3) }
    $1 != "D" { add($2) }
  ' "$work/changes.tsv" | LC_ALL=C sort -u >"$work/js.modules"

  : >"$work/js.importers"
  if [ -s "$work/js.modules" ] && [ -d assets/js/__tests__ ]; then
    local status=0
    # Prints `<test file>:<specifier>` for every relative import specifier; the awk step resolves
    # it against the test's directory and keeps the test when it names a changed module.
    rg --no-config --no-heading --no-line-number --with-filename --only-matching --replace '$1' \
      --glob '*.js' -e '(?:from|import)\s*\(?\s*[\x22\x27](\.{1,2}/[^\x22\x27]*)[\x22\x27]' \
      -- assets/js/__tests__ >"$work/js.imports" || status=$?
    [ "$status" -le 1 ] || die "rg failed with exit status $status"
    awk -F: '
      function resolve(path,   n, part, i, k, stack, out) {
        n = split(path, part, "/")
        for (i = 1; i <= n; i++) {
          if (part[i] == "" || part[i] == ".") continue
          if (part[i] == ".." && k > 0) k--
          else stack[++k] = part[i]
        }
        out = stack[1]
        for (i = 2; i <= k; i++) out = out "/" stack[i]
        return out
      }
      NR == FNR { module[$0]; next }
      {
        dir = $1
        sub(/\/[^\/]*$/, "", dir)
        target = resolve(dir "/" $2)
        if ((target in module) || ((target ".js") in module)) print $1
      }
    ' "$work/js.modules" "$work/js.imports" >"$work/js.importers"
  fi

  { cat "$work/js.changed" "$work/js.importers"; } | sed 's|^assets/||' | LC_ALL=C sort -u >"$work/js.txt"

  awk -F'\t' '$1 != "D" && $2 ~ /^assets\/e2e\/[^\/]*\.spec\.js$/ { sub(/^assets\//, "", $2); print $2 }' \
    "$work/changes.tsv" | LC_ALL=C sort -u >"$work/e2e.txt"
}

report_assets() {
  if [ -s "$work/js.txt" ]; then
    section JavaScript
    sed 's/^/  /' "$work/js.txt"
    echo
    echo "  npm --prefix assets test -- $(paste -s -d ' ' "$work/js.txt")"
  fi

  if [ -s "$work/e2e.txt" ]; then
    section Browser
    sed 's/^/  /' "$work/e2e.txt"
    echo
    echo "  bin/test-browser $(paste -s -d ' ' "$work/e2e.txt")"
  fi
}

# A template, LiveView or component change can alter a browser journey that no selected test
# covers. Either path of a renamed or deleted file counts.
report_advisories() {
  awk -F'\t' '
    {
      for (i = 2; i <= 3; i++) {
        if ($i ~ /^lib\/.*(\.heex|_live\.ex)$/ || $i ~ /^lib\/gtfs_planner_web\/components\// || $i ~ /^lib\/.*components?\.ex$/) {
          found = 1
        }
      }
    }
    END { exit !found }
  ' "$work/changes.tsv" || return 0
  section Advisories
  echo "  Browser journeys may be affected; see the AGENTS.md test table."
}

# run_command <list file> <command words...>: runs the command with the paths in the list file (one
# per line) appended, and keeps the first non-zero status in run_status. Later commands still run.
run_status=0

run_command() {
  local list=$1 status=0 files=() path
  shift
  while IFS= read -r path; do
    files+=("$path")
  done <"$list"
  section "Running: $* ${files[*]}"
  "$@" "${files[@]}" || status=$?
  [ "$run_status" -ne 0 ] || run_status=$status
}

# The ExUnit command, then the JavaScript command. Browser tests are never run.
run_selected() {
  if [ "$exunit_run" -eq 1 ]; then
    run_command "$work/exunit.txt" mix test
  elif [ "$exunit_full" -eq 1 ]; then
    section "Not run: the full-suite recommendation (bin/test-all) is not a selected command"
  fi
  if [ -s "$work/js.txt" ]; then
    run_command "$work/js.txt" npm --prefix assets test --
  fi
}

collect_changes
select_exunit
report_exunit
select_assets
report_assets

# Advisories are not test selections, so they do not suppress the no-selection message.
if [ "$printed" -eq 0 ]; then
  echo "No affected tests found."
  printed=1
fi
report_advisories

[ "$run" -eq 0 ] || run_selected

echo
echo "$advisory"
exit "$run_status"
